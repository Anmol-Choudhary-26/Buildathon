PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vibematch
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Use a separate high-entropy secret. Changing it makes existing PII unreadable.
PII_ENCRYPTION_KEY=replace-with-a-long-random-pii-secret
# Optional separate key for a non-reversible email lookup hash; defaults to PII_ENCRYPTION_KEY.
PII_LOOKUP_KEY=replace-with-another-long-random-secret
# Optional hosted login via Supabase. Use its publishable/anon key only, never service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only key for private property-media Storage bucket. Never add it to frontend/.env.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=property-media
GEOCODER_USER_AGENT=BengaluruVibeMatch/1.0 your-contact-email@example.com
