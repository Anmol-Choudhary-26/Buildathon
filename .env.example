PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vibematch
JWT_SECRET=replace-with-a-long-random-jwt-secret
# Use a separate high-entropy secret. Changing it makes existing PII unreadable.
PII_ENCRYPTION_KEY=replace-with-a-long-random-pii-secret
# Optional separate key for a non-reversible email lookup hash; defaults to PII_ENCRYPTION_KEY.
PII_LOOKUP_KEY=replace-with-another-long-random-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
# Keep this secret only in the backend or Vercel environment variables.
CLOUDINARY_API_SECRET=your-api-secret
# Alternatively, use a single CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name value.
GEOCODER_USER_AGENT=BengaluruVibeMatch/1.0 your-contact-email@example.com
